{
  "name": "opticslab",
  "version": "1.3.0",
  "description": "Interactive optics workbench for geometric ray sketches, teaching demos, and research diagram prototypes",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "npx http-server . -p 8080 -o",
    "dev": "npx http-server . -p 8080 -c-1 -o",
    "test": "npm run lint && npm run test:unit",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/run-smoke-e2e.ps1",
    "test:e2e:core": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/run-web-e2e.ps1 -Profile core",
    "test:e2e:full": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/run-web-e2e.ps1",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "lint": "npx eslint src/"
  },
  "keywords": [
    "optics",
    "simulation",
    "ray-tracing",
    "physics",
    "education",
    "lens",
    "mirror",
    "polarization",
    "diffraction",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions"
  ],
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^10.0.1"
  }
}
